VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=dance-salsa-bachata
VITE_APPWRITE_DATABASE_ID=dance
VITE_APPWRITE_FIGURES_TABLE_ID=figures
VITE_APPWRITE_MEDIA_BUCKET_ID=figure-media
VITE_APPWRITE_LIBRARY_FUNCTION_ID=dance-library
VITE_APPWRITE_USER_MANAGEMENT_FUNCTION_ID=dance-user-management
# Feature flag: "true" o "false". Se la variabile manca, si usa il valore predefinito indicato qui sotto.
VITE_FEATURE_AUTH=true
VITE_FEATURE_DASHBOARD=true
# Mostra le pagine di danza e figura anche senza accesso.
VITE_FEATURE_PUBLIC_CONTENT=false
# Predefinito: disattivate. Preferiti e progressi di "La mia pratica" richiedono VITE_FEATURE_PRACTICE=true.
VITE_FEATURE_PRACTICE=false
VITE_FEATURE_FAVORITES=true
VITE_FEATURE_OFFLINE=true
VITE_FEATURE_INSTALL_GUIDE=true
VITE_FEATURE_THEME=false
VITE_FEATURE_CATALOG=true
VITE_FEATURE_FIGURE_EDITOR=true
VITE_FEATURE_ADMIN_OPERATIONS=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_USER_ROLES=true
