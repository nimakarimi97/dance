VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=dance-salsa-bachata
VITE_APPWRITE_DATABASE_ID=dance
VITE_APPWRITE_FIGURES_TABLE_ID=figures
VITE_APPWRITE_MEDIA_BUCKET_ID=figure-media
# Feature flag: imposta "false" per disattivare una funzione.
VITE_FEATURE_AUTH=true
VITE_FEATURE_DASHBOARD=true
# Mostra le pagine di danza e figura anche senza accesso.
VITE_FEATURE_PUBLIC_CONTENT=false
